        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a legacy export. Dates are inferred using the current time zone. Original IDs, attachment names, visibility, pinned and archived state may be unavailable. Reimporting a legacy export can duplicate memos created before backup IDs were available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是旧版导出文件。日期将根据当前时区推断，可能无法恢复原始标识、附件名称、可见性、置顶和归档状态。再次导入旧版文件可能会重复添加尚无备份标识的 MEMO。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是舊版匯出檔案。日期將根據目前時區推斷，可能無法還原原始識別碼、附件名稱、可見性、置頂和封存狀態。再次匯入舊版檔案可能會重複新增尚無備份識別碼的 MEMO。"
          }
        }
      }
