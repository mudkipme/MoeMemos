    "compat.higher-version.login-warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Memos-Version ist neuer als die von Moe Memos getestete Version. Es kann zu Kompatibilitätsproblemen kommen. Bitte prüfen Sie die Moe-Memos-Website, bevor Sie fortfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Memos version is newer than the version tested by Moe Memos. There might be compatibility issues. Please check the Moe Memos website before continuing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre version de Memos est plus récente que celle testée par Moe Memos. Il peut y avoir des problèmes de compatibilité. Veuillez consulter le site de Moe Memos avant de continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua versione di Memos e piu recente della versione testata da Moe Memos. Potrebbero esserci problemi di compatibilita. Controlla il sito web di Moe Memos prima di continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの Memos バージョンは、Moe Memos で検証済みのバージョンより新しいです。互換性の問題が発生する可能性があります。続行する前に Moe Memos のWebサイトを確認してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша версия Memos новее версии, протестированной в Moe Memos. Возможны проблемы совместимости. Перед продолжением проверьте сайт Moe Memos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 Memos 版本高于 Moe Memos 已验证的版本，可能存在兼容性问题。继续前请先查看 Moe Memos 官网确认是否支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 Memos 版本高於 Moe Memos 已驗證的版本，可能存在相容性問題。繼續前請先查看 Moe Memos 官網確認是否支援。"
          }
        }
      }
    },
    "compat.higher-version.sync-warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Memos-Version ist neuer als die von Moe Memos getestete Version. Eine erzwungene Synchronisierung kann nicht synchronisierte Daten beschädigen. Bitte prüfen Sie die Moe-Memos-Website, bevor Sie fortfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Memos version is newer than the version tested by Moe Memos. Forcing sync may corrupt unsynced data. Please check the Moe Memos website before continuing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre version de Memos est plus récente que celle testée par Moe Memos. Forcer la synchronisation peut corrompre les données non synchronisées. Veuillez consulter le site de Moe Memos avant de continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua versione di Memos e piu recente della versione testata da Moe Memos. Forzare la sincronizzazione potrebbe corrompere i dati non sincronizzati. Controlla il sito web di Moe Memos prima di continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの Memos バージョンは、Moe Memos で検証済みのバージョンより新しいです。同期を強制すると未同期データが破損する可能性があります。続行する前に Moe Memos のWebサイトを確認してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша версия Memos новее версии, протестированной в Moe Memos. Принудительная синхронизация может повредить несинхронизированные данные. Перед продолжением проверьте сайт Moe Memos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 Memos 版本高于 Moe Memos 已验证的版本，强制同步可能损坏未同步数据。继续前请先查看 Moe Memos 官网确认是否支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的 Memos 版本高於 Moe Memos 已驗證的版本，強制同步可能損壞未同步資料。繼續前請先查看 Moe Memos 官網確認是否支援。"
          }
        }
      }
    },
    "compat.supported-versions" : {
